\section{Parameters}{

Parameters from \code{\link{LearnerTorch}}, as well as:
\itemize{
\item \code{n_hidden_layers} :: \code{integer(1)}\cr
The number of hidden layers. Default is \code{3}.
\item \code{hidden_width} :: \code{integer(1)}\cr
The width of the hidden layers. Default is \code{256}.
\item \code{act} :: \code{character(1)}\cr
The activation function, one of \code{"selu"}, \code{"mish"}, \code{"relu"}, \code{"silu"}, \code{"gelu"} and
\code{"elu"}. Default is \code{"selu"} for classification and \code{"mish"} for regression.
\item \code{use_parametric_act} :: \code{logical(1)}\cr
Whether to use parametric activations \eqn{x + \alpha (f(x) - x)} with a learned \eqn{\alpha}
per neuron, initialized with one. Default is \code{TRUE}.
\item \code{p_drop} :: \code{numeric(1)}\cr
The dropout probability. Default is \code{0.15}.
\item \code{p_drop_sched} :: \code{character(1)}\cr
The schedule of the dropout probability. Default is \code{"flat_cos"}.
\item \code{wd} :: \code{numeric(1)}\cr
The decoupled weight decay. Biases are not decayed. Default is \code{0.02}.
\item \code{wd_sched} :: \code{character(1)}\cr
The schedule of the weight decay. Default is \code{"flat_cos"}.
\item \code{lr_sched} :: \code{character(1)}\cr
The schedule of the learning rate. Default is \code{"coslog4"}.
\item \code{bias_lr_factor}, \code{act_lr_factor}, \code{scale_lr_factor}, \code{plr_lr_factor} :: \code{numeric(1)}\cr
The learning rate factors of the biases (default \code{0.1}), the parametric activations
(default \code{0.1}), the scaling layer (default \code{6}) and the periodic embeddings (default \code{0.1}).
All other parameters have the factor \code{1}.
\item \code{add_front_scale} :: \code{logical(1)}\cr
Whether the first layer starts with a learned elementwise scaling. Default is \code{TRUE}.
\item \code{num_emb_type} :: \code{character(1)}\cr
The embedding of the numerical features, one of:
\itemize{
\item \code{"pbld"} (default): \eqn{\mathrm{concat}(W_2 \cos(2 \pi w_1 x + b_1) + b_2, x)}.
\item \code{"pblrd"}: as \code{"pbld"}, with a ReLU after the second linear layer.
\item \code{"pl"}: \eqn{W_2 \mathrm{concat}(\cos(2 \pi w_1 x), \sin(2 \pi w_1 x)) + b_2}.
\item \code{"plr"}: as \code{"pl"}, with a ReLU after the second linear layer.
\item \code{"none"}: no embedding.
}
\item \code{plr_sigma} :: \code{numeric(1)}\cr
The standard deviation of the initialization of the frequencies \eqn{w_1}. Default is \code{0.1}.
\item \code{plr_hidden_1} :: \code{integer(1)}\cr
The number of frequencies (\code{"pbld"}, \code{"pblrd"}) or twice the number of frequencies
(\code{"pl"}, \code{"plr"}, must be even) per feature. Default is \code{16}.
\item \code{plr_hidden_2} :: \code{integer(1)}\cr
The embedding size per feature, including the appended input of \code{"pbld"} and \code{"pblrd"}.
Default is \code{4}.
\item \code{max_one_hot_cat_size} :: \code{integer(1)}\cr
Categorical features with at most \code{max_one_hot_cat_size - 1} levels are one-hot encoded, all
others are embedded. Default is \code{9}.
\item \code{embedding_size} :: \code{integer(1)}\cr
The embedding size of the categorical features. Default is \code{8}.
}

Only for classification:
\itemize{
\item \code{ls_eps} :: \code{numeric(1)}\cr
The label smoothing parameter. Requires the \code{cross_entropy} loss. The smoothing term ignores
the loss's \code{class_weight} and \code{ignore_index}. Default is \code{0.1}.
}

Only for regression:
\itemize{
\item \code{normalize_output} :: \code{logical(1)}\cr
Whether to standardize the target during training. Default is \code{TRUE}.
\item \code{clamp_output} :: \code{logical(1)}\cr
Whether to clamp predictions to the range of the training target. Default is \code{TRUE}.
}

The schedules, as functions of the fraction \eqn{t} of training steps already taken, are:
\itemize{
\item \code{"coslog4"}: \eqn{(1 - \cos(2 \pi \log_2(1 + 15 t))) / 2}, four cycles of increasing length.
\item \code{"flat_cos"}: one for \eqn{t < 0.5}, followed by a cosine decay to zero.
\item \code{"cos"}: a cosine decay from one to zero.
\item \code{"linear"}: \eqn{1 - t}.
\item \code{"constant"}: one.
}
}

\examples{
\dontshow{if (torch::torch_is_installed()) withAutoprint(\{ # examplesIf}
# Define the Learner and set parameter values
learner = lrn("classif.realmlp")
learner$param_set$set_values(
  epochs = 1, batch_size = 16, device = "cpu",
  n_hidden_layers = 2, hidden_width = 32
)

# Define a Task
task = tsk("iris")

# Create train and test set
ids = partition(task)

# Train the learner on the training ids
learner$train(task, row_ids = ids$train)

# Make predictions for the test rows
predictions = learner$predict(task, row_ids = ids$test)

# Score the predictions
predictions$score()
\dontshow{\}) # examplesIf}
}
